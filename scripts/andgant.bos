#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, lights, covers, pad, pipes, electrode1, electrode2, nanobox1,
       nanobox2, boxlathe1, boxlathe2, gearbox1, gearbox2, gear1, gear2, gear3,
       gear4;

static-var  Static_Var_1, statechg_DesiredState, statechg_StateChanging;

// Signal definitions
#define SIG_ACTIVATE			2

Build()
{
	while( Static_Var_1 )
	{
		emit-sfx 2048 from gear1;
		emit-sfx 2048 from gear2;
		emit-sfx 2048 from gear3;
		emit-sfx 2048 from gear4;		
		sleep 60;
	}
}

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from base;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

OpenYard()
{
	set YARD_OPEN to 1;
	while( !get YARD_OPEN )
	{
		set BUGGER_OFF to 1;
		sleep 1500;
		set YARD_OPEN to 1;
	}
	set BUGGER_OFF to 0;
}

CloseYard()
{
	set YARD_OPEN to 0;
	while( get YARD_OPEN )
	{
		set BUGGER_OFF to 1;
		sleep 1500;
		set YARD_OPEN to 0;
	}
	set BUGGER_OFF to 0;
}

activatescr()
{
	move nanobox1 to x-axis [20.000000] speed [15.000000];
	move nanobox2 to x-axis [-20.000000] speed [15.000000];
	wait-for-move nanobox2 along x-axis;
	move gearbox1 to x-axis [11.000000] speed [15.000000];
	move gearbox2 to x-axis [-11.000000] speed [15.000000];
	wait-for-move gearbox1 along x-axis;
	spin gear1 around y-axis speed <200.038462>;
	spin gear2 around y-axis speed <200.038462>;
	spin gear3 around y-axis speed <200.038462>;
	spin gear4 around y-axis speed <200.038462>;
}

Go()
{
	call-script activatescr();
	call-script OpenYard();
	set INBUILDSTANCE to 1;
}

deactivatescr()
{
	move nanobox1 to x-axis [0.000000] speed [25.000000];
	move nanobox2 to x-axis [0.000000] speed [25.000000];
	wait-for-move nanobox2 along x-axis;
	move gearbox1 to x-axis [0.000000] speed [25.000000];
	move gearbox2 to x-axis [0.000000] speed [25.000000];
	wait-for-move gearbox1 along x-axis;
	spin gear1 around y-axis speed <0.000000>;
	spin gear2 around y-axis speed <0.000000>;
	spin gear3 around y-axis speed <0.000000>;
	spin gear4 around y-axis speed <0.000000>;
}

Stop()
{
	set INBUILDSTANCE to 0;
	call-script CloseYard();
	call-script deactivatescr();
}

InitState()
{
	statechg_DesiredState = TRUE;
	statechg_StateChanging = FALSE;
}

RequestState(requestedstate, currentstate)
{
	if( statechg_StateChanging )
	{
		statechg_DesiredState = requestedstate;
		return (0);
	}
	statechg_StateChanging = TRUE;
	currentstate = statechg_DesiredState;
	statechg_DesiredState = requestedstate;
	while( statechg_DesiredState != currentstate )
	{
		if( statechg_DesiredState == 0 )
		{
			call-script Go();
			currentstate = 0;
		}
		if( statechg_DesiredState == 1 )
		{
			call-script Stop();
			currentstate = 1;
		}
	}
	statechg_StateChanging = FALSE;
}

Create()
{
	cache base;
	cache pipes;
	cache covers;
	dont-cache electrode1;
	dont-cache electrode2;
	dont-cache nanobox1;
	dont-cache nanobox2;
	dont-cache lights;
	dont-cache gear1;
	dont-cache gear2;
	dont-cache gear3;
	dont-cache gear4;
	spin electrode1 around y-axis speed <7.000000>;
	spin electrode2 around y-axis speed <-7.000000>;
	Static_Var_1 = 1;
	call-script InitState();
	start-script SmokeUnit();
}

QueryNanoPiece(piecenum)
{
	if( Static_Var_1 == 1 )
	{
		piecenum = boxlathe1;
	}
	if( Static_Var_1 == 2 )
	{
		piecenum = boxlathe2;
	}
	if( Static_Var_1 == 3 )
	{
		piecenum = gear1;
	}
	if( Static_Var_1 == 4 )
	{
		piecenum = gear2;
	}
	++Static_Var_1;
	if( Static_Var_1 == 5 )
	{
		Static_Var_1 = 1;
	}
}

Activate()
{
	signal SIG_ACTIVATE;
	start-script RequestState(0);
}

Deactivate()
{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	set-signal-mask 0;
	start-script RequestState(1);
}

StartBuilding()
{
	start-script Build();
}

StopBuilding()
{
}

QueryBuildInfo(piecenum)
{
	piecenum = pad;
}

SweetSpot(piecenum)
{
	piecenum = base;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 99 )
	{
		corpsetype = 3;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	corpsetype = 3;
	explode base type BITMAPONLY | BITMAP1;
}
