// DUE Nanolather Facility

piece base,lights,covers,pad,pipes,nanoring,electrode1,electrode2,nanospot1,nanospot2,nanobox1,nanobox2,boxlathe1,boxlathe2,gearbox1,gearbox2,gear1,gear2;

static-var spray_0;

#define	SIG_ACTIVATE	2
#define SMOKEPIECE1 base
#define ANIM_VARIABLE TRUE

#include "StateChg.h"
#include "smokeunit.h"
#include "exptype.h"
#include "yard.h"

Go()
	{
	call-script activatescr();
	call-script OpenYard();
	set INBUILDSTANCE to TRUE;
	}

activatescr()
	{
	move nanobox1 to x-axis [20] speed [15];
	move nanobox2 to x-axis [-20] speed [15];
	wait-for-move nanobox2 to x-axis;
	spin gear1 around y-axis speed <200>;
	spin gear2 around y-axis speed <200>;
	spin nanoring around y-axis speed <50>;
	}

deactivatescr()
	{
	move nanobox1 to x-axis [0] speed [25];
	move nanobox2 to x-axis [0] speed [25];
	wait-for-move nanobox2 to x-axis;
	spin gear1 around y-axis speed <0>;
	spin gear2 around y-axis speed <0>;
	spin nanoring around y-axis speed <0>;
	}

Stop()
	{
	set INBUILDSTANCE to FALSE;
	call-script CloseYard();
	call-script deactivatescr();
	}

#define ACTIVATECMD call-script Go();
#define DEACTIVATECMD call-script Stop();
#include "StateChg.h"

Create()
	{
	cache base;
	cache pipes;
	cache covers;
	dont-cache electrode1;
	dont-cache electrode2;
	dont-cache nanobox1;
	dont-cache nanobox2;
	dont-cache nanoring;
	dont-cache lights;
	dont-cache gear1;
	dont-cache gear2;
	spin electrode1 around y-axis speed <7>;
	spin electrode2 around y-axis speed <-7>;
	spray_0 = 1;
	call-script InitState();
	start-script SmokeUnit();
	}

QueryNanoPiece(piecenum)
	{
	IF (spray_0 == 1 )
		{
		piecenum = boxlathe1;
		}
	IF (spray_0 == 2 )
		{
		piecenum = boxlathe2;
		}
	IF (spray_0 == 3 )
		{
		piecenum = nanospot1;
		}
	IF (spray_0 == 4 )
		{
		piecenum = nanospot2;
		}
	spray_0 = spray_0 + 1 ;
	IF (spray_0 == 5 )
		{
		spray_0 = 1;
		}
	}

Activate()
	{
	signal SIG_ACTIVATE;
	start-script RequestState( ACTIVE );
	}

Deactivate()
	{
	signal SIG_ACTIVATE;
	set-signal-mask SIG_ACTIVATE;
	set-signal-mask 0;
	start-script RequestState( INACTIVE );
	}

StartBuilding()
	{
	}


StopBuilding()
	{
	}

QueryBuildInfo(piecenum)
	{
	piecenum=pad;
	}

SweetSpot(piecenum)
	{
	piecenum=base;
	}

Killed( severity, corpsetype )
	{
	if (severity <= 25)
		{
		corpsetype = 1;
		explode base type	BITMAPONLY | BITMAP1;
		return( 0 );
		}

	if (severity <= 50)
		{
		corpsetype = 2;
		explode base type	BITMAPONLY | BITMAP1;
		return( 0 );
		}

	if (severity <= 99)
		{
		corpsetype = 3;
		explode base type	BITMAPONLY | BITMAP1;
		return( 0 );
		}

	corpsetype = 3;
	explode base type	BITMAPONLY | BITMAP1;
	return( 0 );
	}
