#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, camino, tubi, caldaia, fumo_1, fumo_2, fumo_3, portellone,
       rotator, link_slider, link;

static-var  Static_Var_1;


ChangeStatusFromLUA(Func_Var_1)
{
	Static_Var_1 = Func_Var_1;
}

GeneraFumo()
{
	while( TRUE )
	{
		if( Static_Var_1 == 1 )
		{
			emit-sfx 1024 from fumo_1;
			emit-sfx 1024 from fumo_2;
			emit-sfx 1024 from fumo_3;						
		}
		sleep 1200;
	}
}

SmokeUnit(healthpercent, sleeptime, smoketype)
{
	while( get BUILD_PERCENT_LEFT )
	{
		sleep 400;
	}
	while( TRUE )
	{
		healthpercent = get HEALTH;
		if( healthpercent < 66 )
		{
			smoketype = 256 | 2;
			if( Rand( 1, 66 ) < healthpercent )
			{
				smoketype = 256 | 1;
			}
			emit-sfx smoketype from base;
		}
		sleeptime = healthpercent * 50;
		if( sleeptime < 200 )
		{
			sleeptime = 200;
		}
		sleep sleeptime;
	}
}

TransportPickup(unitid)
{
	var Func_Var_2, Func_Var_3, Func_Var_4;
	signal 2;
	set-signal-mask 2;
	set BUSY to 1;
	Func_Var_2 = get PIECE_XZ(base) - get UNIT_XZ(unitid);
	Func_Var_3 = get XZ_ATAN(Func_Var_2);
	Func_Var_4 = get XZ_HYPOT(Func_Var_2);
	turn rotator to y-axis Func_Var_3 now;
	move link_slider to z-axis Func_Var_4 now;
	turn link to y-axis <-90.000000> now;
	attach-unit unitid to link;
	turn rotator to y-axis <0.000000> speed <25.000000>;
	wait-for-turn rotator around y-axis;
	move portellone to y-axis [25.000000] speed [30.000000];
	wait-for-move portellone along y-axis;
	turn link to y-axis <180.000000> speed <60.000000>;
	wait-for-turn link around y-axis;
	move link_slider to z-axis [0.000000] speed [20.000000];
	wait-for-move link_slider along z-axis;
	move portellone to y-axis [0.000000] speed [30.000000];
	wait-for-move portellone along y-axis;
	attach-unit unitid to 0 - 1;
	turn link to y-axis <0.000000> now;
	set BUSY to 0;
}

TransportDrop(unitid, position)
{
	var Func_Var_3, Func_Var_4, Func_Var_5;
	signal 2;
	set-signal-mask 2;
	set BUSY to 1;
	turn rotator to y-axis <0.000000> now;
	move link_slider to z-axis [0.000000] now;
	turn link to y-axis <0.000000> now;
	attach-unit unitid to link;
	move portellone to y-axis [25.000000] speed [30.000000];
	wait-for-move portellone along y-axis;
	move link_slider to z-axis [60.000000] speed [25.000000];
	wait-for-move link_slider along z-axis;
	move portellone to y-axis [0.000000] speed [30.000000];
	Func_Var_3 = get PIECE_XZ(base) - position;
	Func_Var_4 = get XZ_ATAN(Func_Var_3);
	Func_Var_5 = get XZ_HYPOT(Func_Var_3);
	turn link to y-axis <90.000000> speed <60.000000>;
	wait-for-turn link around y-axis;
	turn rotator to y-axis Func_Var_4 speed <25.000000>;
	move link_slider to z-axis Func_Var_5 speed [25.000000];
	wait-for-turn rotator around y-axis;
	wait-for-move link_slider along z-axis;
	turn link to y-axis <0.000000> speed <60.000000>;
	wait-for-turn link around y-axis;
	drop-unit unitid;
	move link_slider to z-axis [0.000000] now;
	turn rotator to y-axis <0.000000> now;
	set BUSY to 0;
}

Create()
{
	start-script SmokeUnit();
	start-script GeneraFumo();
}

SweetSpot(piecenum)
{
	piecenum = base;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	if( severity <= 99 )
	{
		corpsetype = 3;
		explode base type BITMAPONLY | BITMAP1;
		return (0);
	}
	corpsetype = 3;
	explode base type BITMAPONLY | BITMAP1;
}
